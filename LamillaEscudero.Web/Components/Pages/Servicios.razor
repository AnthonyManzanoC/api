        : staticServices.Select((s, i) => new CatalogService($"base-{i}", s.Titulo, s.Desc, s.Icono, s.Detalles)).ToList();

    private bool Coincide(CatalogService servicio)
    {
        var consulta = searchTerm.Trim();
        if (consulta.Length == 0) return true;

        var comparador = System.Globalization.CultureInfo.GetCultureInfo("es").CompareInfo;
        var opciones = System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace;
        return new[] { servicio.Titulo, servicio.Desc, servicio.Detalles }
            .Any(texto => texto is not null && comparador.IndexOf(texto, consulta, opciones) >= 0);
    }

